    {
      "name": "Reusable write methods (select resource variable)",
      "description": "Change the resource collection variable to a dataset name. POST includes an id so it works with datasets whose records do not already have one. PUT, PATCH and DELETE need an existing item ID; inventory and matches do not have IDs in their source records. The service does not persist changes.",
      "item": [
        {
          "name": "POST - Create item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"postman-test\",\n  \"title\": \"Postman test record\",\n  \"description\": \"Created by the collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/{{resource}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Item is created', function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT - Replace item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"Postman replacement record\",\n  \"description\": \"Replaced by the collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/{{resource}}/{{recordId}}"
          }
        },
        {
          "name": "PATCH - Update item",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman updated record\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/{{resource}}/{{recordId}}"
          }
        },
        {
          "name": "DELETE - Remove item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}/{{recordId}}"
          }
        }
      ]
    },
