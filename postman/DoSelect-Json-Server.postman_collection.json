    {
      "name": "Query parameter patterns",
      "description": "Reusable JSON Server v0.17 examples for field filters, full-text search, sort, pagination, and combining query parameters. Change the collection variables to test different fields and values.",
      "item": [
        {
          "name": "Filter by field equality",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?{{queryField}}={{queryValue}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filter returns an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by numeric range",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?id_gte=1&id_lte={{pageSize}}"
          }
        },
        {
          "name": "Filter by not-equal operator",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?id_ne={{recordId}}"
          }
        },
        {
          "name": "Filter by partial text match",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?title_like=Learn"
          }
        },
        {
          "name": "Match multiple values",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?id=1&id=2"
          }
        },
        {
          "name": "Full-text search",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?q={{queryValue}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Search returns an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sort ascending",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?_sort={{sortField}}&_order=asc"
          }
        },
        {
          "name": "Sort descending",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?_sort={{sortField}}&_order=desc"
          }
        },
        {
          "name": "Paginate",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?_start={{offset}}&_limit={{pageSize}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Page size does not exceed the requested limit', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array').with.length.at.most(Number(pm.variables.get('pageSize')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Paginate by page number",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?_page=1&_limit={{pageSize}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Page response is an array within the requested limit', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array').with.length.at.most(Number(pm.variables.get('pageSize')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Paginate by start and end indexes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?_start={{offset}}&_end={{pageSize}}"
          }
        },
        {
          "name": "Combine filter, sort and pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/{{resource}}?{{queryField}}={{queryValue}}&_sort={{sortField}}&_order=asc&_start={{offset}}&_limit={{pageSize}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Combined query returns an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
