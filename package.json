{
  "name": "jserver",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "DoSelect Json Server",
  "main": "src/index.ts",
  "scripts": {
    "dev": "LOG_PRETTY=true node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node src/index.ts",
    "start:dist": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "npm run lint && npm run typecheck && vitest run",
    "test:watch": "vitest",
    "generate:employees": "node dev/generate-employees.ts",
    "generate:leaves": "node dev/generate-leaves.ts",
    "generate:notes": "node dev/generate-notes.ts",
    "generate:countries": "node dev/generate-countries.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doselect/jsonserver.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/doselect/jsonserver/issues"
  },
  "homepage": "https://github.com/doselect/jsonserver#readme",
  "dependencies": {
    "express": "^4.22.3",
    "json-server": "^0.17.4",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "@types/rosie": "0.0.45",
    "countrycitystatejson": "^26.9.2802",
    "eslint": "10.13.0",
    "image-downloader": "^4.3.1",
    "json-beautify": "^1.1.1",
    "neostandard": "0.14.1",
    "rosie": "^2.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
