# --- jsonserver ---
# Copy to .env for local runs (`npm run dev` loads it). In deployments set these as real environment variables.

PORT=8888
# Folder of the JSON files to serve; empty for the repository's data/ folder
DATA_DIRECTORY=
# SIGTERM waits this long for in-flight requests
SHUTDOWN_TIMEOUT_MS=10000

# --- Logging: the DoSelect logging standard, as in eden ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# JSON lines on stdout (what containers should use)
LOG_STDOUT=true
# Also write <LOG_DIRECTORY>/application.log, rotated daily into application-YYYY-MM-DD.log.gz.
# Servers use /webapps/jsonserver/logs/ (shipped by Filebeat) and LOG_STDOUT=false
LOG_DIRECTORY=
# Days of rotated log files kept
LOG_RETENTION_DAYS=14
# Added to every line as `do_service` and `do_role`
SERVICE_NAME=jsonserver
SERVICE_ROLE=jsonserver
# true turns all logging off (tests)
SILENT=false
# Indented JSON instead of one object per line (`npm run dev` sets it)
LOG_PRETTY=false
